# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here

# Database
DB_PATH=birkasjourney.db

# JWT Auth
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# App
APP_HOST=0.0.0.0
APP_PORT=8000
TIMEZONE=Asia/Almaty

# Browser origins allowed to call the API, comma-separated.
# Leave as * for local development. When deployed, set it to the site's own
# origin, e.g. https://birkas-journey.up.railway.app
ALLOWED_ORIGINS=*
